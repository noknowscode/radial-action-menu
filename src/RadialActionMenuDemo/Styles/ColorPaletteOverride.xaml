<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Monochromatic Black/Grey - Primary is dark grey -->
      <Color x:Key="PrimaryColor">#1F1F1F</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#E0E0E0</Color>
      <Color x:Key="OnPrimaryContainerColor">#1F1F1F</Color>

      <!-- Secondary - Medium grey -->
      <Color x:Key="SecondaryColor">#4A4A4A</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#F0F0F0</Color>
      <Color x:Key="OnSecondaryContainerColor">#2D2D2D</Color>

      <!-- Tertiary - Light grey -->
      <Color x:Key="TertiaryColor">#757575</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#FAFAFA</Color>
      <Color x:Key="OnTertiaryContainerColor">#424242</Color>

      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>

      <!-- Clean white/grey background -->
      <Color x:Key="BackgroundColor">#FAFAFA</Color>
      <Color x:Key="OnBackgroundColor">#1F1F1F</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1F1F1F</Color>
      <Color x:Key="SurfaceVariantColor">#F5F5F5</Color>
      <Color x:Key="OnSurfaceVariantColor">#616161</Color>
      <Color x:Key="OutlineColor">#BDBDBD</Color>
      <Color x:Key="OnSurfaceInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceInverseColor">#1F1F1F</Color>
      <Color x:Key="PrimaryInverseColor">#E0E0E0</Color>
      <Color x:Key="SurfaceTintColor">#1F1F1F</Color>
      <Color x:Key="OutlineVariantColor">#E0E0E0</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- Monochromatic - Light grey as primary in dark mode -->
      <Color x:Key="PrimaryColor">#E0E0E0</Color>
      <Color x:Key="OnPrimaryColor">#1F1F1F</Color>
      <Color x:Key="PrimaryContainerColor">#424242</Color>
      <Color x:Key="OnPrimaryContainerColor">#F5F5F5</Color>

      <Color x:Key="SecondaryColor">#BDBDBD</Color>
      <Color x:Key="OnSecondaryColor">#1F1F1F</Color>
      <Color x:Key="SecondaryContainerColor">#616161</Color>
      <Color x:Key="OnSecondaryContainerColor">#F0F0F0</Color>

      <Color x:Key="TertiaryColor">#9E9E9E</Color>
      <Color x:Key="OnTertiaryColor">#1F1F1F</Color>
      <Color x:Key="TertiaryContainerColor">#757575</Color>
      <Color x:Key="OnTertiaryContainerColor">#FAFAFA</Color>

      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>

      <Color x:Key="BackgroundColor">#121212</Color>
      <Color x:Key="OnBackgroundColor">#E0E0E0</Color>
      <Color x:Key="SurfaceColor">#1E1E1E</Color>
      <Color x:Key="OnSurfaceColor">#E0E0E0</Color>
      <Color x:Key="SurfaceVariantColor">#2D2D2D</Color>
      <Color x:Key="OnSurfaceVariantColor">#BDBDBD</Color>
      <Color x:Key="OutlineColor">#757575</Color>
      <Color x:Key="OnSurfaceInverseColor">#1F1F1F</Color>
      <Color x:Key="SurfaceInverseColor">#E0E0E0</Color>
      <Color x:Key="PrimaryInverseColor">#424242</Color>
      <Color x:Key="SurfaceTintColor">#E0E0E0</Color>
      <Color x:Key="OutlineVariantColor">#424242</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
