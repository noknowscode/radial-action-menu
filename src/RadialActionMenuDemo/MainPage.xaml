<Page x:Class="RadialActionMenuDemo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:RadialActionMenuDemo"
      xmlns:controls="using:RadialActionMenuDemo.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      Background="{ThemeResource BackgroundBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Padding="24,48,24,24"
                        Spacing="8">
                <TextBlock Text="Radial Action Menu"
                           Style="{StaticResource HeadlineMedium}"
                           Foreground="{ThemeResource OnBackgroundBrush}"/>
                <TextBlock Text="Tap the FAB buttons in the bottom corners to see the radial action menus."
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Demo content placeholder -->
            <Grid Grid.Row="1"
                  Padding="24">
                <Border Background="{ThemeResource SurfaceVariantBrush}"
                        CornerRadius="16"
                        Padding="24">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="48"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                        <TextBlock x:Name="ActionFeedback"
                                   Text="Your content goes here"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Try the radial menus"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{ThemeResource OutlineBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Left Radial Action Menu - 5 items -->
        <controls:RadialActionMenu x:Name="LeftRadialMenu"
                                   Position="BottomLeft"
                                   ItemSelected="OnRadialMenuItemSelected"/>

        <!-- Right Radial Action Menu - 4 items -->
        <controls:RadialActionMenu x:Name="RightRadialMenu"
                                   Position="BottomRight"
                                   ItemSelected="OnRadialMenuItemSelected"/>
    </Grid>
</Page>
